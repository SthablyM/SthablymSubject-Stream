// OPTION A: Firebase Cloud Function  (recommended — free tier covers Stablym's scale)
//
//   Setup:
//     npm install -g firebase-tools
//     firebase login && firebase init functions
//     Paste this into functions/index.js
//     firebase deploy --only functions
//
//   Your webhook URL will be:
//     https://us-central1-YOUR_PROJECT_ID.cloudfunctions.net/payfastNotify
// ─────────────────────────────────────────────────────────────────────────────

const functions = require("firebase-functions");
const admin     = require("firebase-admin");
const crypto    = require("crypto");

admin.initializeApp();
const db = admin.firestore();

const PAYFAST_PASSPHRASE = "mmathapelo/1S";  // keep this secret — move to env var in production
const PLAN_DURATIONS = {                      // how many days each plan gives
  premium_monthly: 31,
  premium_annual:  366,
  parent:          31,
  school_starter:  31,
  school_standard: 31,
  school_pro:      31,
  uni_listed:      31,
  uni_featured:    31,
};

exports.payfastNotify = functions.https.onRequest(async (req, res) => {
  // 1. Only accept POST
  if (req.method !== "POST") return res.status(405).send("Method Not Allowed");

  const data = req.body;

  // 2. Verify PayFast signature
  const pfParamString = Object.keys(data)
    .filter(k => k !== "signature")
    .map(k => `${k}=${encodeURIComponent(String(data[k])).replace(/%20/g, "+")}`)
    .join("&");

  const toHash = PAYFAST_PASSPHRASE
    ? `${pfParamString}&passphrase=${encodeURIComponent(PAYFAST_PASSPHRASE)}`
    : pfParamString;

  const expectedSig = crypto.createHash("md5").update(toHash).digest("hex");

  if (data.signature !== expectedSig) {
    console.error("PayFast ITN: signature mismatch", { got: data.signature, expected: expectedSig });
    return res.status(400).send("Invalid signature");
  }

  // 3. Check payment status
  if (data.payment_status !== "COMPLETE") {
    console.log("PayFast ITN: payment not complete →", data.payment_status);
    return res.status(200).send("OK");  // always 200 so PayFast doesn't retry
  }

  // 4. Extract our custom fields (set in initiatePayFastPayment)
  const uid    = data.custom_str1;  // Firebase UID
  const planId = data.custom_str2;  // e.g. "premium_monthly"

  if (!uid || !planId) {
    console.error("PayFast ITN: missing custom_str1 or custom_str2", data);
    return res.status(200).send("OK");
  }

  // 5. Activate plan in Firestore
  const days = PLAN_DURATIONS[planId] || 31;
  const expiresAt = Date.now() + days * 24 * 60 * 60 * 1000;

  try {
    await db.collection("users").doc(uid).set({
      plan:              planId,
      expiresAt,
      lastPaymentAt:     Date.now(),
      lastPaymentId:     data.m_payment_id,
      lastPaymentAmount: data.amount_gross,
      updatedAt:         Date.now(),
    }, { merge: true });

    // Optional: log payment to separate collection for auditing
    await db.collection("payments").doc(data.m_payment_id).set({
      uid,
      planId,
      amount:    data.amount_gross,
      paidAt:    Date.now(),
      payfastId: data.pf_payment_id,
      email:     data.email_address,
    });

    console.log(`✅ Plan activated: uid=${uid} plan=${planId} expires=${new Date(expiresAt).toISOString()}`);
  } catch(e) {
    console.error("Firestore write failed:", e);
    // Still return 200 — we don't want PayFast to retry forever
  }

  return res.status(200).send("OK");
});


